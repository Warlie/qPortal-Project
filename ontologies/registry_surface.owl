<?xml version="1.0" encoding="UTF-8"?>
<!--
	Das Vokabular des Registrierungsbogens @registry_surface_system.

	Bis 2026-09 stand das hier als tag_open()-Folge in TreeEngine::build_up().
	Es ist reine Deklaration: geprägt wird ein Name, damit er als Tag brauchbar
	ist — eine PHP-Klasse je Tag braucht es nicht. STWs eigener Kommentar an der
	alten Stelle: "Coining them here is what makes them usable as tags at all."

	NICHT hier, und das ist die Naht: der Bindungsblock. <System> mit seiner
	pedl:ParameterCollection hängt echte Objekte in den Baum (cdata_ref auf
	Parser, Datenbank, ContentGenerator) und greift zwei Elemente ab
	(get_Element für CurRef und EffBranch). Ein Verweis auf ein laufendes Objekt
	lässt sich nicht aufschreiben — der Block bleibt in PHP. Ebenso die beiden
	rdf:Bag-Behälter, die zur Laufzeit gefüllt werden.

	Geladen wird diese Datei von TreeEngine::build_up(), NACH createTree() und
	VOR dem Bindungsblock: createTree legt den Namensraum mit seinem nativen
	Knoten an (ohne den bricht das Laden mit "native namespace is missing" ab),
	und der Bindungsblock benutzt Tags, die hier erst geprägt werden.
	Der Pfad steht in config/default.ini unter [runtime].

	⚠ Wer hier einen Namen ergänzt, prägt ihn — und wer die Prägung vergisst,
	merkt nichts: use_ns_def_strict(true) WIRFT NICHT bei einem ungeprägten Tag,
	es fällt auf einen generischen Interface_node zurück. Der Tag funktioniert,
	die Seite rendert, nur die Bedeutung ist weg.
-->
<rdf:RDF
	xmlns="@registry_surface_system"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema"
	xmlns:owl="http://www.w3.org/2002/07/owl"
	xmlns:pedl="http://www.w3.org/2006/05/pedl-lib"
	xmlns:dcterms="http://purl.org/dc/terms/"
	xmlns:tree="http://www.trscript.de/tree">

	<!-- Der Bogen benennt sich selbst. dcterms:identifier ist der Standardbegriff
	     dafuer ("an unambiguous reference to the resource within a given context")
	     und braucht keine Erfindung.
	     ⚠ Das ist eine AUSSAGE ueber das Dokument, keine Parserregel: rdf:ID loest
	     weiter gegen den Default-Namensraum des Baums auf (rdf_ID.php:57,
	     get_NS('', idx)). Der Bezeichner macht die IDs noch nicht eindeutig - er ist
	     die Basis, gegen die eine spaetere Eindeutigkeit ueberhaupt erst formuliert
	     werden kann. Erst die Basis, dann die Einmaligkeit darin. -->
	<owl:Ontology rdf:about="@registry_surface_system">
		<dcterms:identifier>@registry_surface_system</dcterms:identifier>
		<dcterms:title xml:lang="de">Registrierungsbogen</dcterms:title>
		<dcterms:description>Vokabular der Flaeche: die gepraegten Namen, aus denen
		der Bogen und die PEDL-Ernte ihre Tags nehmen.</dcterms:description>

		<!-- Die Version des SYSTEMS, nicht dieses Dokuments - und sie steht hier, weil der
		     Bogen die Stelle ist, an der qPortal ueber sich selbst spricht: committet statt
		     installationsabhaengig, beim Aufbau ohnehin geladen, und damit in der
		     Selbstauskunft sichtbar. owl:versionInfo ist der Standardbegriff dafuer und
		     wird hier zum ersten Mal benutzt.

		     STWs Zaehlung (2026-09-12):
		       1.0  lauffaehig, ein Monolith
		       2.0  das Verhalten aus dem Monoliten gemeisselt - die Namensraum-Sammlung.
		            Im Archivstand vom Oktober 2012 steht sie bereits.
		       3.0  die Semantik. Sie war lange unterwegs und ist mit __query fertig
		            geworden: ein System, das sagen kann was es ist, aber nicht danach
		            gefragt werden kann, hat die Stufe nicht ganz.
		       4.0  wenn der PHP-Quelltext einmalig aus den Dokumenten heraus ersetzt wird.
		            Dann ein neues Repository - der Bruch ist zu brutal fuer dieselbe
		            Historie, und danach gibt es eher einen laufenden Strom als Versionen.
		-->
		<owl:versionInfo>3.0</owl:versionInfo>
	</owl:Ontology>

	<!-- Geprägt aus den pedl-Grundlagen. Interfaces und Traits sind Deklarationen
	     wie eine Klasse und kommen aus derselben Grundlage; Eigenschaften und
	     Konstanten sind benannte Plätze und nehmen die Parameter-Grundlage. -->
	<pedl:Object_Class       rdf:ID="PhpClass"/>
	<pedl:Object_Funktion    rdf:ID="PhpMethod"/>
	<pedl:Object_Constructor rdf:ID="PhpConstructor"/>
	<pedl:Object_Parameter   rdf:ID="PhpParameter"/>
	<pedl:Object_Class       rdf:ID="PhpInterface"/>
	<pedl:Object_Class       rdf:ID="PhpTrait"/>
	<pedl:Object_Parameter   rdf:ID="PhpProperty"/>
	<pedl:Object_Parameter   rdf:ID="PhpConstant"/>

	<!-- Zweite Stufe: aus den geprägten Namen wieder Namen prägen. -->
	<PhpClass     rdf:ID="System"/>
	<PhpParameter rdf:ID="Variable"/>

	<Variable rdf:ID="System.Parser"/>
	<Variable rdf:ID="System.Database"/>
	<Variable rdf:ID="System.FuncTree"/>
	<Variable rdf:ID="System.Content"/>
	<Variable rdf:ID="System.CurRef"/>
	<Variable rdf:ID="System.EffBranch"/>
	<Variable rdf:ID="System.Exception"/>

	<owl:Class rdf:ID="Class_Collection"/>
	<owl:Class rdf:ID="Class_Instance"/>

	<rdf:Property rdf:about="#has_method">
		<rdfs:domain rdf:resource="#PhpClass"/>
		<rdfs:range  rdf:resource="#PhpMethod"/>
	</rdf:Property>

	<rdf:Property rdf:about="#has_constructor">
		<rdfs:domain rdf:resource="#PhpClass"/>
		<rdfs:range  rdf:resource="#PhpConstructor"/>
	</rdf:Property>

	<rdf:Property rdf:about="#has_parameter">
		<rdfs:domain rdf:resource="#PhpMethod"/>
		<rdfs:range  rdf:resource="#PhpParameter"/>
	</rdf:Property>

	<!-- Die tree-Knoten als Funktionen benennen: Vokabular, kein Verhalten.
	     rdf:about mit VOLLER URI, nicht rdf:ID — beide lösen am '#' auf
	     (rdf_ID.php:57 / rdf_about.php:83): ohne '#' gilt der Namensraum dieses
	     Bogens, also ein NEUER Name; mit '#' der davor, also der vorhandene
	     tree-Knoten aus classes/ns/tree/class_index.php.
	     tree:tree ist eine FREIE Funktion — sie wird über ihren Namen gerufen,
	     die Argumente sind die restliche Namensliste der Nachricht. Darum nicht
	     pedl:Object_Funktion, die braucht einen Empfänger. -->
	<pedl:Object_Class rdf:ID="Funktion"/>
	<Funktion rdf:about="http://www.trscript.de/tree#tree"/>
	<Funktion rdf:about="http://www.trscript.de/tree#first"/>
	<Funktion rdf:about="http://www.trscript.de/tree#final"/>

	<!-- tree:name als Bezeichner - aber nur, wo das eine Aussage ist.
	     subPropertyOf sagt: tree:name tut, was rdf:ID tut. Was es NICHT sagt, und
	     was der Knoten selbst entscheidet (classes/ns/tree/tree_name.php): es tut
	     das nur auf tree und final, und nur wenn der Wert selbst einen Namensraum
	     nennt ("praefix;Name" oder ein voller URI). Ein blanker Name loest gegen
	     den Default-Namensraum auf, den sich 571 Dokumente teilen - dort ist er
	     kein Bezeichner, sondern ein Flur zum Durchlaufen.
	     ⚠ rdfs:subPropertyOf traegt heute kein Verhalten (rdfs_subPropertyOf.php
	     ist eine leere Knotenklasse, wie subClassOf). Diese Zeile ist die Aussage
	     darueber, was tree:name IST; getan wird es im Knoten. -->
	<rdf:Property rdf:about="http://www.trscript.de/tree#name">
		<rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#ID"/>
	</rdf:Property>

</rdf:RDF>
